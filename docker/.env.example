# Copy to docker/.env and adjust for your environment.
# cp docker/.env.example docker/.env
#
# Kintsugi test org setup (one-time, in Kintsugi UI):
#   1. Create a Kill Bill connection on your test org
#   2. Set the connection HMAC secret → copy to KINTSUGI_HMAC_SECRET below
#   3. Note the Kill Bill tenant API key on the connection (external_id)
#      → must equal KILLBILL_API_KEY below
#
# The plugin does NOT use Kintsugi organization_id or Kintsugi API keys.
# Kintsugi resolves your org from X-Killbill-ApiKey (the Kill Bill tenant key).

# Kill Bill (docker compose stack)
KILLBILL_URL=http://127.0.0.1:8080
KILLBILL_ADMIN_USER=admin
KILLBILL_ADMIN_PASSWORD=password

# Kill Bill tenant credentials — create in Kaui with this API key, or use defaults bob/lazar
# MUST match the Kintsugi Kill Bill connection external_id (tenant API key)
KILLBILL_API_KEY=bob
KILLBILL_API_SECRET=lazar

# Kintsugi API (reachable from the Kill Bill Docker container)
KINTSUGI_URL=https://api.trykintsugi.com
# KINTSUGI_URL=https://api.sandbox.trykintsugi.com

# Must match HMAC secret on the Kintsugi Kill Bill connection (not the org API key)
KINTSUGI_HMAC_SECRET=change-me-to-match-kintsugi-connection

# smoke-invoice.sh ship-to state (needs active tax registration in your test org)
SMOKE_TAX_STATE=TX
